{
  "name": "@aicqtools/cli",
  "version": "1.0.0-alpha.6",
  "type": "module",
  "description": "aicq command-line interface — `aicq check`, `aicq mcp`, `aicq sync-ai-rules`, `aicq provenance`, `aicq docs build`.",
  "keywords": [
    "aicq",
    "aicqtools",
    "cli",
    "ai",
    "code-quality",
    "guardrail",
    "linter",
    "mcp"
  ],
  "homepage": "https://github.com/aicqtools/aicqtools/tree/main/packages/cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/aicqtools/aicqtools.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/aicqtools/aicqtools/issues",
  "author": "Eom Sik <neuralflux3@gmail.com>",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aicq": "./dist/bin.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aicqtools/core": "workspace:*",
    "@aicqtools/guardrail": "workspace:*",
    "@aicqtools/provenance": "workspace:*",
    "@aicqtools/rule-sdk": "workspace:*",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "tree-sitter": "~0.22.4",
    "tree-sitter-python": "~0.23.6",
    "tree-sitter-typescript": "~0.23.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
